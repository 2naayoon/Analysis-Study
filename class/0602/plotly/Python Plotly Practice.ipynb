        "# Iris 데이터셋으로 사용자 정의 색상 적용\n",
        "px.scatter(iris_df,\n",
        "    x=\"sepal_width\",\n",
        "    y=\"sepal_length\",\n",
        "    color=\"species\",\n",
        "    # 종별로 특정 색상 지정\n",
        "    color_discrete_map={\n",
        "        \"setosa\": \"rgb(255,0,0)\",      # 빨강\n",
        "        \"versicolor\": \"rgba(0,255,0,0.7)\", # 녹색 (투명도 0.7)\n",
        "        \"virginica\": \"blue\"            # 파랑\n",
        "    },\n",
        "    title=\"Iris 데이터셋 - 사용자 정의 색상 (color_discrete_map)\")"
      ]
    },
