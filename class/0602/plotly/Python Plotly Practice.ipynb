        "# [1-2] 코드 작성 셀\n",
        "# 'Canada의 연도별 lifeExp 선 그래프\n",
        "canada_df = gapminder_df.query('country == \"Canada\"')\n",
        "fig_canada_life_exp = px.line(canada_df,\n",
        "                              x= \"year\",\n",
        "                              y= \"lifeExp\",\n",
        "                              markers= \"year\",\n",
        "                              title= \"캐나다의 연도별 기대수명 변화\")\n",
        "fig_canada_life_exp.show()"
      ]
    },
