      "source": [
        "agg_tips_df = tips_df.groupby(['day'], as_index=False).agg({'tip': 'mean'})\n",
        "\n",
        "fig = px.bar(agg_tips_df,\n",
        "             x= 'day',\n",
        "             y= 'tip',\n",
        "             color = 'day',\n",
        "             color_discrete_sequence=px.colors.qualitative.Pastel,\n",
        "             title= \"요일별 평균 팁 금액\",\n",
        "             labels={\"day\": \"요일\", \"tip\": \"평균 팁\"}\n",
        "            )\n",
        "\n",
        "# 각 바 위에 평균 팁 값 표시\n",
        "fig.update_layout(\n",
        "    annotations=[\n",
        "        dict(\n",
        "            text=f\"{agg_tips_df.loc[i, 'tip']:.2f}\",\n",
        "            x=agg_tips_df.loc[i, 'day'],\n",
        "            y=agg_tips_df.loc[i, 'tip'] + 0.1,\n",
        "            showarrow=False\n",
        "        ) for i in range(len(agg_tips_df))\n",
        "    ]\n",
        ")\n",
        "\n",
        "fig.show()"
      ]
    },
