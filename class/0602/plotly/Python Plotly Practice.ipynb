        "# Tips 데이터셋에서 요일별 팁 금액 바이올린 플롯\n",
        "px.violin(tips_df,\n",
        "    y=\"tip\",\n",
        "    x=\"day\",\n",
        "    color=\"sex\", # 성별에 따라 색상 구분\n",
        "    box=True,    # 바이올린 내부에 박스플롯 표시\n",
        "    points=\"all\", # 모든 데이터 포인트 표시\n",
        "    title=\"요일별 팁 금액 분포 (바이올린 플롯)\")"
      ]
    },
